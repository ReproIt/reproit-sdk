{
  "name": "@reproit/sdk",
  "version": "1.0.0",
  "description": "Bounded Repro It Backend operation capture for Node.js",
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.d.ts",
      "default": "./src/public.js"
    },
    "./register": {
      "types": "./src/register.d.ts",
      "default": "./src/register.js"
    }
  },
  "types": "./src/index.d.ts",
  "files": [
    "src/encoding.js",
    "src/engine-operation.js",
    "src/http-adapter.js",
    "src/index.d.ts",
    "src/managed-json.js",
    "src/managed-subject-files.js",
    "src/managed-subject-runtime.js",
    "src/managed-subject.js",
    "src/native-engine.js",
    "src/observation-adapters.js",
    "src/process-resources.js",
    "src/processor-capture.js",
    "src/public.js",
    "src/register.d.ts",
    "src/register.js",
    "src/runtime-observation-adapters.js",
    "src/semantic-dependency.js",
    "src/semantic-observation.js",
    "src/sqlite-adapter.js",
    "src/subject-protocol.js",
    "native"
  ],
  "engines": {
    "node": ">=24 <25"
  },
  "license": "Apache-2.0",
  "scripts": {
    "test": "node --test test/*.test.js"
  }
}
