  "operations": [
    "contract",
    "dependency-finish",
    "dependency-open",
    "engine-close",
    "engine-open",
    "observation-abandon",
    "observation-dispatch",
    "observation-finish",
    "observation-open",
    "observation-read",
    "observation-write",
    "operation-abandon",
    "operation-begin",
    "operation-close-world",
    "operation-fail",
    "operation-input",
    "operation-succeed",
    "operation-unowned",
    "sink-wait"
